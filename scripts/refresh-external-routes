#!/usr/bin/env bash
# =============================================================================
# refresh-external-routes
# Refreshes IPs for configured domains and updates routing rules.
# Run periodically via cron or systemd timer.
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CONF_PATHS=(
    "/etc/llx-external-routes/config.conf"
    "$SCRIPT_DIR/../conf/config.conf"
)

# Load configuration
CONF_FOUND=false
for CONF_FILE in "${CONF_PATHS[@]}"; do
    if [[ -f "$CONF_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONF_FILE"
        CONF_FOUND=true
        break
    fi
done

if [[ "$CONF_FOUND" == false ]]; then
    echo "ERROR: Config file not found in any of: ${CONF_PATHS[*]}" >&2
    exit 1
fi

LIB_PATHS=(
    "/usr/local/lib/llx-external-routing/common-routing.sh"
    "$SCRIPT_DIR/lib/common-routing.sh"
)

LIB_FOUND=false
for LIB_FILE in "${LIB_PATHS[@]}"; do
    if [[ -f "$LIB_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$LIB_FILE"
        LIB_FOUND=true
        break
    fi
done

if [[ "$LIB_FOUND" == false ]]; then
    echo "ERROR: common-routing.sh not found in any of: ${LIB_PATHS[*]}" >&2
    exit 1
fi

LOG_TAG="refresh"

IPSETS_DIR="/etc/llx-external-routes/ipsets"
mkdir -p "$IPSETS_DIR" 2>/dev/null || true

# =============================================================================
# Main
# =============================================================================

log_msg 1 "Starting external route refresh"

if ! is_routing_enabled; then
    log_msg 1 "Routing disabled (ENABLED=0), skipping refresh"
    exit 0
fi

if ! is_external_up; then
    log_msg 1 "Interface $EXTERNAL_IFACE is not up, skipping refresh"
    exit 0
fi

local_gw=$(get_external_gateway)

if [[ -z "$local_gw" ]]; then
    log_msg 0 "ERROR: Could not get gateway for $EXTERNAL_IFACE"
    exit 1
fi

log_msg 1 "External gateway: $local_gw"

# Create routing table if it doesn't exist
if ! grep -q "^$ROUTING_TABLE " /etc/iproute2/rt_tables 2>/dev/null; then
    echo "$ROUTING_TABLE external" >> /etc/iproute2/rt_tables 2>/dev/null || true
fi

# Update default route in external table
ip route replace default via "$local_gw" dev "$EXTERNAL_IFACE" table "$ROUTING_TABLE" 2>/dev/null || true

# Remove existing rules
while ip rule del table "$ROUTING_TABLE" 2>/dev/null; do :; done

# Add DNS rules
dns_servers=$(get_external_dns)
for dns in $dns_servers; do
    if [[ -n "$dns" ]]; then
        ip rule add to "$dns" table "$ROUTING_TABLE" priority 10 2>/dev/null || true
        log_msg 2 "DNS rule: $dns -> table $ROUTING_TABLE"
    fi
done

# Resolve domains and add rules
add_domain_rules

# Add rules for literal IPs/CIDRs (no DNS resolution needed)
add_static_ip_rules

# Default rule
ip rule add table "$ROUTING_TABLE" priority 99 2>/dev/null || true

log_msg 1 "Refresh completed"
